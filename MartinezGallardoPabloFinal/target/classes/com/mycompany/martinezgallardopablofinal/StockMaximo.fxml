<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="262.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.martinezgallardopablofinal.StockMaximoController">
   <children>
      <Label layoutX="96.0" layoutY="32.0" text="STOCK MÁXIMO DE PRODUCTOS">
         <font>
            <Font name="System Bold" size="26.0" />
         </font>
      </Label>
      <Label layoutX="29.0" layoutY="130.0" text="ID producto:" />
      <TextField fx:id="campoIdProducto" layoutX="103.0" layoutY="126.0" />
      <TextField fx:id="campoPrecio" editable="false" layoutX="401.0" layoutY="126.0" />
      <Label layoutX="300.0" layoutY="130.0" text="Precio máximo (€):" />
      <Button fx:id="btnCalcular" layoutX="147.0" layoutY="167.0" mnemonicParsing="false" onAction="#calcular" text="Calcular" />
      <Button fx:id="btnVolver" layoutX="536.0" layoutY="222.0" mnemonicParsing="false" onAction="#volver" text="Volver" />
      <Button fx:id="btnLimpiar" layoutX="149.0" layoutY="209.0" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar" />
   </children>
</AnchorPane>
